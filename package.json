{
  "name": "kiwidown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A static, browser-based WYSIWYG Markdown editor that renders with real Typora themes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "themes:fetch": "node scripts/fetch-themes.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "themes:stats": "node scripts/theme-stats.mjs",
    "themes:shoot": "npm run build && node scripts/shoot-themes.mjs",
    "ui:shoot": "npm run build && node scripts/shoot-ui.mjs",
    "base:fetch": "node scripts/fetch-typora-base.mjs",
    "smoke": "node scripts/smoke-dev.mjs",
    "check:contract": "npm run build && node scripts/check-contract.mjs",
    "probe:tokens": "node scripts/probe-tokens.mjs"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "fflate": "^0.8.3",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2",
    "undici": "^6.28.0",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@milkdown/kit": "^7.21.3",
    "katex": "^0.18.1",
    "lucide": "^1.27.0",
    "mermaid": "^11.16.0",
    "refractor": "^5.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-math": "^6.0.0"
  }
}
